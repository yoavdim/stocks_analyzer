{
    "npv_common": {
        "discount_rate_percent": 10
    },
    "npv_assumptions": {
        "short_term_growth_duration": 8,
        "maximal_long_term_growth_rate_percent": 3,
        "long_term_growth_duration": -1,
        "add_mode": "none",
        "forward_to_present": false,
        "short_term_is_linear": false,
        "irr_search_step_percent": 0.1,
        "irr_search_min": -0.9,
        "irr_search_max": 1.0,
        "portfolio_risk_free_rate_percent": 4
    },
    "linear_irr": {
        "long_term_growth_duration": 0,
        "short_term_growth_duration": 10
    },
    "npv_calculator": {
        "default_growth_time": 5,
        "default_perpetuity_growth_percent": 2,
        "default_discount_rate_percent": 10
    },
    "portfolio": {
        "forecast_policy": "past",
        "forecast_growth_field": "irr[%]",
        "use_shrinkage": true,
        "base_currency": "USD"
    },
    "tldr_fields": [
        "pe_ratio",
        "price_to_book",
        "peg_ratio",
        "irr[%]",
        "dcf_discount_ratio",
        "current_ratio",
        "growth_rate",
        "bv_growth_rate",
        "healthy",
        "overvalued",
        "leveraged"
    ],
    "quick_filters": {
        "healthy": {
            "logic": "and",
            "conditions": [
                ["eps", ">", 0],
                ["book_value", ">", 0],
                ["earnings_yearly_trend", ">", 0],
                ["equity_yearly_trend", ">", 0],
                ["operating_cf_yearly_trend", ">", 0],
                ["revenues_yearly_trend", ">", 0],
                ["minimal_operating_cf", ">", 0],
                ["roe[%]", ">=", 10],
                ["roa[%]", ">=", 3],
                ["growth_rate", ">=", 2.5],
                ["bv_growth_rate", ">=", 2.5],
                ["revenue_growth_rate", ">=", 1.7]
            ]
        },
        "leveraged": {
            "logic": "or",
            "conditions": [
                ["debt_to_equity", ">", 3.2],
                ["non_operating_cf_yearly_trend", ">", 0],
                ["maximal_non_operating_cf", ">", 0]
            ]
        },
        "overvalued": {
            "logic": "or",
            "conditions": [
                ["pe*bv", ">=", 100],
                ["naive_time_to_profit", ">=", 20],
                ["irr[%]", "<", 10],
                ["basic_discount_ratio", "<", -10],
                ["capm_discount_ratio", "<", -10]
            ]
        }
    }
}
